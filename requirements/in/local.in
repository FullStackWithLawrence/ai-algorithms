#
# usage: developer support packages for code syntax and type checking, testing,
#        formatting, security, quality, vanity, debugging, build & packaging
#
#      pip-compile requirements/in/local.in -o requirements/local.txt
# -----------------------------------------------------------------------------

-r constraints.in
-r base.in

pip-tools
pre-commit      # runs the hooks in .pre-commit-config.yaml; CI installs its pin from local.txt

# Code linters, formatters, and security scanners
# ------------
bandit
black
codespell
flake8
flake8-coding
isort
mypy
mypy_extensions
pydocstringformatter
pylint
tox
